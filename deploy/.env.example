# Copy thành deploy/.env trên VPS. Không commit file .env.

# Domain trỏ về VPS (dùng khi chạy kèm Caddy)
DOMAIN=noithan.example.com
# Phiên bản image (front + back cùng một tag); lệnh cập nhật trong README tự ghi giá trị này
APP_VERSION=latest

# Superuser của PocketBase (trang quản trị /_/). Mật khẩu nên dài (≥ 10 ký tự).
# Được đặt lại theo giá trị này mỗi lần khởi động.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=doi-mat-khau-nay-that-dai

# Tài khoản chủ app + household đầu tiên: chỉ dùng ở LẦN KHỞI ĐỘNG ĐẦU (dữ liệu trống).
# Mật khẩu tối thiểu 8 ký tự.
NOI_OWNER_EMAIL=chu-app@example.com
NOI_OWNER_PASSWORD=doi-mat-khau-nay
NOI_HOUSEHOLD_NAME=Nhà mình
